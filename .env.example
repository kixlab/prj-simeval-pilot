# OpenAI agent runtime. Keep the API key server-side.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1-mini

# Claude, for `--provider anthropic` in scripts/audraAgentDriver.mjs.
ANTHROPIC_API_KEY=

# This experimental branch enables Agent mode in code and restricts it to Free Draw + Text.
VITE_ENABLE_AGENT_MODE=true
ENABLE_AGENT_API=true

# Preferred: absolute path to a Google Cloud service-account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=

# Only enable this when the server intentionally uses gcloud ADC or an attached service account.
GOOGLE_STT_ALLOW_ADC=false

# Optional Google Speech-to-Text settings.
GOOGLE_STT_LANGUAGE_CODE=ko-KR
GOOGLE_STT_ALTERNATIVE_LANGUAGE_CODES=en-US
GOOGLE_STT_MODEL=latest_long
